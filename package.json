{
  "name": "@khaentertainment/pi-jev2",
  "version": "0.4.0",
  "description": "System One classifiers (TypeSafe Jev and others, via TypeSafe, OpenRouter, Cloudflare and more) as a decision layer for Pi: judges mutating tool calls before they run, reads tool output for secrets and failure class after, escalates flagged calls to an orchestrator (Pi parent, Traycer, A2A), and exposes jev_ask for typed calibrated answers",
  "homepage": "https://github.com/KHAEntertainment/pi-jev2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KHAEntertainment/pi-jev2.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "typesafe",
    "jev",
    "system-one",
    "openrouter",
    "cloudflare",
    "guardrails",
    "classification",
    "orchestration",
    "a2a",
    "traycer"
  ],
  "license": "MIT",
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/bun": "latest",
    "@types/node": "^22",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/KHAEntertainment/pi-jev2/issues"
  },
  "author": "KHAEntertainment (fork of y0usaf/pi-jev)",
  "scripts": {
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "calibrate": "bun scripts/calibrate.ts"
  }
}
